  completedRegionsCount: 0
  regionDatabase:
  - type: 0
    displayName: "Regi\xF3n Caribe"
    subtitle: "Tierra de brisa marina, sabanas y murallas hist\xF3ricas"
    ecosystem: Costas, manglares, arrecifes y desierto de La Guajira
    climate: "C\xE1lido tropical, seco y semi\xE1rido en el norte"
    guardianName: "Guardi\xE1n de la Brisa Dorada"
    description: "Abarca las c\xE1lidas llanuras costeras del norte, desde las hist\xF3ricas fortalezas de Cartagena hasta los paisajes \xE1ridos de La Guajira."
    minigames:
    - "Gesti\xF3n de agua en La Guajira (Conservaci\xF3n h\xEDdrica)"
    - 'Memoria: Flora y fauna costera representativa'
    themeColor: {r: 0.98, g: 0.76, b: 0.28, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 1
    displayName: "Regi\xF3n Andina"
    subtitle: "El coraz\xF3n de las tres cordilleras y los p\xE1ramos"
    ecosystem: "Bosques de niebla, p\xE1ramos, valles y nieves perpetuas"
    climate: "Variedad de pisos t\xE9rmicos (de c\xE1lido a g\xE9lido)"
    guardianName: "Guardi\xE1n de los Nevados"
    description: "Es la zona m\xE1s monta\xF1osa y poblada del pa\xEDs. Cruza las cordilleras Occidental, Central y Oriental albergando los p\xE1ramos m\xE1s ricos en agua del mundo."
    minigames:
    - "Escalada y ascenso respondiendo sobre pisos t\xE9rmicos"
    - "Simulaci\xF3n de cultivo sostenible en ladera cafetera"
    themeColor: {r: 0.42, g: 0.78, b: 0.98, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 2
    displayName: "Regi\xF3n Orinoqu\xEDa"
    subtitle: Los infinitos Llanos Orientales y atardeceres de fuego
    ecosystem: Sabana tropical inundable, esteros y morichales
    climate: "Tropical de sabana (estaci\xF3n seca y lluviosa)"
    guardianName: "Guardi\xE1n del Sol Llanero"
    description: "Inmensas llanuras ba\xF1adas por afluentes del r\xEDo Orinoco, donde conviven chig\xFCiros, garzas y una arraigada cultura ganadera y musical."
    minigames:
    - "Carrera llanera esquivando obst\xE1culos y conociendo fauna"
    - "Puzzle del ciclo de inundaci\xF3n y sequ\xEDa"
    themeColor: {r: 0.96, g: 0.58, b: 0.22, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 3
    displayName: "Regi\xF3n Amaz\xF3nica"
    subtitle: "El pulm\xF3n verde del mundo y hogar ancestral"
    ecosystem: "Selva h\xFAmeda tropical densa, r\xEDos caudalosos e igap\xF3s"
    climate: "C\xE1lido y muy h\xFAmedo (ecuatorial)"
    guardianName: "Guardi\xE1n del Yag\xE9 y los Grandes R\xEDos"
    description: "La mayor reserva biol\xF3gica del planeta, poblada por delfines rosados, guacamayas, jaguares y pueblos ind\xEDgenas guardianes de la selva."
    minigames:
    - "Navegaci\xF3n en canoa registrando especies y frenando deforestaci\xF3n"
    - "Quiz visual de biodiversidad amaz\xF3nica"
    themeColor: {r: 0.35, g: 0.85, b: 0.45, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 4
    displayName: "Regi\xF3n Espiritual"
    subtitle: El santuario celestial de los guardianes
    ecosystem: "Reino ancestral m\xEDstico flotante"
    climate: "Energ\xEDa arm\xF3nica pura"
    guardianName: "Gran Esp\xEDritu Protector de Colombia"
    description: "Un espacio sagrado que une el conocimiento de todas las regiones. Se revela a los exploradores que han demostrado respeto y comprensi\xF3n por la naturaleza colombiana."
    minigames:
    - "Desaf\xEDo del Altar: Integraci\xF3n de los 6 fragmentos de sabidur\xEDa"
    - Enigma de la Biodiversidad Nacional
    themeColor: {r: 0.45, g: 0.95, b: 0.85, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 5
    displayName: "Regi\xF3n Pac\xEDfica"
    subtitle: Cuna de biodiversidad, selva pluvial y ballenas jorobadas
    ecosystem: "Selvas muy h\xFAmedas, estuarios, manglares y litoral"
    climate: "Extremadamente lluvioso y c\xE1lido h\xFAmedo"
    guardianName: "Guardi\xE1n de la Lluvia y las Mareas"
    description: "Una de las zonas m\xE1s lluviosas del planeta. Sus aguas son santuario anual de ballenas y sus r\xEDos arterias de vida y riqueza cultural afrodescendiente e ind\xEDgena."
    minigames:
    - 'Restaura el manglar: Retira residuos y ubica plantas'
    - Conecta animales con sus refugios y conoce el ecosistema
    themeColor: {r: 0.28, g: 0.72, b: 0.62, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
  - type: 6
    displayName: "Regi\xF3n Insular"
    subtitle: "Para\xEDsos oce\xE1nicos del Caribe y del Pac\xEDfico"
    ecosystem: "Arrecifes de coral, playas, cayos y ecosistemas pel\xE1gicos"
    climate: "Tropical mar\xEDtimo c\xE1lido"
    guardianName: "Guardi\xE1n de los Arrecifes"
    description: "Compuesta por San Andr\xE9s, Providencia y Santa Catalina en el Caribe, y Malpelo y Gorgona en el Pac\xEDfico. Es cuna de la Reserva de Bi\xF3sfera Seaflower."
    minigames:
    - 'Frutas de las Islas: Recoge frutas siguiendo el mouse'
    - Descubre datos sobre la diversidad de frutas tropicales
    themeColor: {r: 0.32, g: 0.82, b: 0.92, a: 1}
    sliceSprite: {fileID: 0}
    normalOffset: {x: 0, y: 0}
    isLocked: 0
