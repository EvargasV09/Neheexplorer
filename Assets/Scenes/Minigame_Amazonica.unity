      m_Calls: []
  m_text: "<color=#FFE385><size=150%><b>Expedici\xF3n por el Amazonas</b></size></color>\n\n<b>W / S o flechas arriba / abajo:</b> cambia de carril.\n<b>Espacio:</b> fotograf\xEDa las especies frente a la canoa.\nTambi\xE9n puedes usar los botones en pantalla.\nEsquiva los obst\xE1culos y completa el recorrido con tus fotos.\n\n<color=#FFE385><b>Pulsa cualquier tecla para comenzar</b></color>"
  m_isRightToLeft: 0
