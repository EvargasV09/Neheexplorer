  m_Script: {fileID: 11500000, guid: 8adf1bd9681b9c84991aad4729911bd8, type: 3}
  m_Name: Orinoquia_RunnerData
  m_EditorClassIdentifier: Assembly-CSharp::Nehexplorer.OrinoquiaRunnerDataSet
  minigameTitle: "Carrera Llanera: Traves\xEDa por la Sabana"
  instructions: "Usa las flechas [Arriba / Abajo] o [W / S] o los botones t\xE1ctiles para cambiar de carril. \xA1Rescata la fauna llanera y esquiva los obst\xE1culos en la sabana!"
  totalDistance: 1200
  scrollSpeed: 65
  startingLives: 3
  requiredFaunaCount: 5
  winFactTitle: "\xBFSab\xEDas que...?"
  winEducationalFact: "Los Llanos Orientales y sus morichales (palmas de moriche que retienen agua subterr\xE1nea) son vitales para la supervivencia de especies \xFAnicas como el Chig\xFCiro, el Oso Palmero y el Delf\xEDn de R\xEDo (Tonina). La cultura llanera y sus cantos de vaquer\xEDa han sido declarados Patrimonio Inmaterial de la Humanidad por la UNESCO."
  faunaList:
  - id: Chiguiro
    name: "Chig\xFCiro de los Esteros"
    shortLabel: "CHIG\xDCIRO"
    emoji: "\u2605"
    educationalNote: "Es el roedor viviente m\xE1s grande del planeta. Vive en manadas y se sumerge en el agua para regular su temperatura corporal."
    points: 100
    sprite: {fileID: 2880895720517664074, guid: 0cfcaad065b02a646ac57241839fe25f, type: 3}
    itemColor: {r: 0.96, g: 0.72, b: 0.35, a: 1}
  - id: OsoPalmero
    name: Oso Palmero Gigante
    shortLabel: OSO PALMERO
    emoji: "\u2605"
    educationalNote: Posee una lengua de hasta 60 cm y poderosas garras para alimentarse de termiteros sin destruirlos por completo.
    points: 120
    sprite: {fileID: 628192430448080777, guid: c2bdddfc9efe80e4dbc1b9f0a789d82b, type: 3}
    itemColor: {r: 0.94, g: 0.62, b: 0.38, a: 1}
  - id: GarzaCorocora
    name: Corocora Roja
    shortLabel: COROCORA
    emoji: "\u2605"
    educationalNote: "Garza de plumaje escarlata brillante que surca los esteros llaneros; su color proviene de los crust\xE1ceos que come."
    points: 110
    sprite: {fileID: 8334594754406588362, guid: 3b9883569b19aa94c9d570de774bfd18, type: 3}
    itemColor: {r: 0.98, g: 0.45, b: 0.4, a: 1}
  - id: VenadoSabanero
    name: Venado Cola Blanca
    shortLabel: VENADO
    emoji: "\u2605"
    educationalNote: "\xC1gil ciervo de los pastizales llaneros que recorre las sabanas en busca de pastos tiernos y brotes de moriche."
    points: 130
    sprite: {fileID: 7954047022441327530, guid: 8310be0c8cc41f646945f270791e62f2, type: 3}
    itemColor: {r: 0.88, g: 0.75, b: 0.48, a: 1}
  - id: Tonina
    name: "Tonina (Delf\xEDn de R\xEDo)"
    shortLabel: TONINA
    emoji: "\u2605"
    educationalNote: "Delf\xEDn de agua dulce que nada en los r\xEDos Meta, Arauca y Orinoco; indicador clave de la salud de las cuencas."
    points: 150
    sprite: {fileID: -5592873691468668497, guid: 0366bcdbfc029ca4e9cac47e2347bb01, type: 3}
    itemColor: {r: 0.45, g: 0.78, b: 0.95, a: 1}
  obstacleList:
  - id: Tronco
    name: "Tronco Ca\xEDdo"
    shortLabel: TRONCO
